doctype html
html
  body
    p Dear #{ name },

    if status === 'APPROVED'
      p Your asset "#{ assetTitle }" has been successfully approved by the admin.
      p You can log in to your dashboard to view and manage your asset.

    else if status === 'REJECTED'
      p Your asset "#{ assetTitle }" has been rejected by the admin.
      if rejection
        p Reason: #{ rejection }
      p You may review and resubmit after making necessary changes.

    p For any assistance, feel free to contact support.

    br
    p Best regards,
    p Team Fracto
