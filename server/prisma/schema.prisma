model ChatRoom {
  id            Int            @id @default(autoincrement())
  name          String?
  type          ChatroomType
  createdById   Int            @map("created_by_id")
  lastMessageId Int?           @map("last_message_id")
  assetId       Int?           @map("asset_id")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  createdBy     Account        @relation(fields: [createdById], references: [id])
  lastMessage   Message?       @relation("LastMessage", fields: [lastMessageId], references: [id])
  asset         Asset?         @relation(fields: [assetId], references: [id])
  members       ChatRoomUser[]
  messages      Message[]

  @@index([type])
  @@map("chat_room")
}

enum MessageType {
  Text  @map("text")
  Image @map("image")
  File  @map("file")

  @@map("message_type")
}

enum MessageStatus {
  Sent      @map("sent")
  Delivered @map("delivered")
  Read      @map("read")

  @@map("message_status")
}

model Message {
  id         Int           @id @default(autoincrement())
  chatRoomId Int           @map("chat_room_id")
  senderId   Int           @map("sender_id")
  content    String?       @map("content")
  mediaUrl   String?       @map("media_url")
  type       MessageType
  status     MessageStatus @default(Sent)
  deletedAt  DateTime?     @map("deleted_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  chatRoom   ChatRoom      @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     Account       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  chatRooms  ChatRoom[]    @relation("LastMessage")

  @@index([chatRoomId, createdAt])
  @@map("message")
}

model ChatRoomUser {
  id          Int       @id @default(autoincrement())
  chatRoomId  Int       @map("chat_room_id")
  accountId   Int       @map("user_id")
  lastReadAt  DateTime? @map("last_read_at")
  unreadCount Int       @default(0) @map("un_read_count")
  clearedAt   DateTime? @map("clear_at")
  isMuted     Boolean   @default(false) @map("is_muuted")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  chatRoom    ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, accountId])
  @@index([accountId])
  @@map("chat_room_user")
}

model BlockedUser {
  id        Int      @id @default(autoincrement())
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker Account @relation("Blocker", fields: [blockerId], references: [id])
  blocked Account @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@map("blocked_user")
}

model Icons {
  id   Int     @id @default(autoincrement())
  name String?
  url  String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("icon")
}

model PropertyInterest {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  icon        String
  iconId      Int?   @map("icon_id")
  asset       Asset? @relation(fields: [assetId], references: [id])
  assetId     Int?   @map("asset_id")

  @@map("property_interest")
}

enum CategoryStatus {
  Active   @map("active")
  Inactive @map("inactive")

  @@map("category_status")
}

enum CategoryRequestStatus {
  Pending  @map("pending")
  Approved @map("approved")
  Rejected @map("rejected")

  @@map("category_request_status")
}

model Category {
  id                Int                   @id @default(autoincrement())
  name              String
  categoryStatus    CategoryStatus        @default(Active) @map("category_status")
  categoryReqStatus CategoryRequestStatus @default(Pending) @map("category_req_status")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  group             Group[]
  account           Account?              @relation(fields: [accountId], references: [id])
  accountId         Int?                  @map("account_id")

  @@map("category")
}

enum GroupStatus {
  Active   @map("active")
  Inactive @map("inactive")

  @@map("group_status")
}

model Group {
  id                Int                @id @default(autoincrement())
  title             String
  description       String
  image             String?
  isHighlighted     Boolean            @default(false) @map("is_highlighted")
  groupStatus       GroupStatus        @default(Active) @map("group_status")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  groupMember       GroupMember[]
  category          Category?          @relation(fields: [categoryId], references: [id])
  categoryId        Int?               @map("category_id")
  sharedAssetGroups SharedAssetGroup[]

  @@map("group")
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  group     Group?   @relation(fields: [groupId], references: [id])
  groupId   Int?     @map("group_id")
  account   Account? @relation(fields: [accountId], references: [id])
  accountId Int?     @map("account_id")

  @@unique([accountId, groupId])
  @@map("group_member")
}

enum SharedAssetStatus {
  Pending  @map("pending")
  Approved @map("approved")
  Rejected @map("rejected")

  @@map("shared_asset_status")
}

model SharedAsset {
  id                  Int               @id @default(autoincrement())
  assetId             Int               @unique @map("asset_id")
  sharedById          Int               @map("shared_by_id")
  tokenAmount         Decimal?          @map("token_amount")
  status              SharedAssetStatus @default(Pending)
  approvedBy          Int?              @map("approved_by")
  submittedToGroupIds Int[]             @default([]) @map("submitted_to_group_ids")
  approvedAt          DateTime?         @map("approved_at")
  rejectNote          String?           @map("reject_note")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  asset    Asset   @relation(fields: [assetId], references: [id])
  sharedBy Account @relation("SharedAssets", fields: [sharedById], references: [id])

  groupShares SharedAssetGroup[]
  interests   AssetInterest[]

  @@map("shared_asset")
}

model SharedAssetGroup {
  id            Int      @id @default(autoincrement())
  sharedAssetId Int      @map("shared_asset_id")
  groupId       Int      @map("group_id")
  sharedBy      String?  @map("shared_by")
  createdAt     DateTime @default(now()) @map("created_at")

  sharedAsset SharedAsset @relation(fields: [sharedAssetId], references: [id])
  group       Group       @relation(fields: [groupId], references: [id])

  @@unique([sharedAssetId, groupId])
  @@map("shared_asset_group")
}

enum InterestPaymentStatus {
  Pending @map("pending")
  Paid    @map("paid")
  Failed  @map("failed")

  @@map("interest_payment_status")
}

model AssetInterest {
  id                Int                    @id @default(autoincrement())
  sharedAssetId     Int                    @map("shared_asset_id")
  accountId         Int                    @map("account_id")
  groupId           Int?                   @map("group_id")
  tokenAmount       Decimal                @map("token_amount") // amount paid
  paymentStatus     InterestPaymentStatus? @map("payment_status")
  isPayment         Boolean                @default(false) @map("is_payment")
  razorpayOrderId   String?                @map("razorpay_order_id")
  razorpayPaymentId String?                @map("razorpay_payment_id")
  paidAt            DateTime?              @map("paid_at")

  payerName         String?   @map("payer_name")
  payerMobile       String?   @map("payer_mobile")
  payerEmail        String?   @map("payer_email")
  amountPaid        Decimal?  @map("amount_paid")
  utrNumber         String?   @map("utr_number")
  paymentScreenshot String?   @map("payment_screenshot")
  rejectionReason   String?   @map("rejection_reason")
  reviewedById      Int?      @map("reviewed_by_id")
  reviewedAt        DateTime? @map("reviewed_at")
  secondaryClubId   Int?      @map("secondary_club_id")
  paymentRequestId  Int?      @map("payment_request_id")
  consent           Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sharedAsset SharedAsset @relation(fields: [sharedAssetId], references: [id])
  account     Account     @relation(fields: [accountId], references: [id])

  @@unique([sharedAssetId, accountId])
  @@map("asset_interest")
}

enum ListingType {
  Ask @map("ask")
  Bid @map("bid")

  @@map("listing_type")
}

enum ListingStatus {
  Active    @map("active")
  Partial   @map("partial")
  Cancelled @map("cancelled")
  Fulfilled @map("fulfilled")
  Expired   @map("expired")

  @@map("listing_status")
}

enum TradeType {
  AskFulfilled @map("ask_fulfilled")
  BidFulfilled @map("bid_fulfilled")
  MarketSell   @map("market_sell")

  @@map("trade_type")
}

model MarketplaceListing {
  id             Int           @id @default(autoincrement())
  assetId        Int           @map("asset_id")
  accountId      Int           @map("account_id")
  type           ListingType   @map("type")
  pricePerUnit   Decimal       @map("price_per_unit")
  totalUnits     Int           @map("total_units")
  remainingUnits Int           @map("remaining_units")
  status         ListingStatus @default(Active)
  expiresAt      DateTime?     @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  asset   Asset              @relation(fields: [assetId], references: [id])
  account Account            @relation(fields: [accountId], references: [id])
  trades  MarketplaceTrade[]

  potentialMatchesAsAsk MarketplacePotentialMatch[] @relation("AskPotentialMatch")
  potentialMatchesAsBid MarketplacePotentialMatch[] @relation("BidPotentialMatch")

  @@index([assetId, type, status])
  @@index([accountId])
  @@map("marketplace_listing")
}

model MarketplaceTrade {
  id           Int       @id @default(autoincrement())
  assetId      Int       @map("asset_id")
  listingId    Int?      @map("listing_id")
  buyerId      Int?      @map("buyer_id")
  sellerId     Int       @map("seller_id")
  tradeType    TradeType @map("trade_type")
  pricePerUnit Decimal   @map("price_per_unit")
  units        Int
  totalAmount  Decimal   @map("total_amount")
  buyerRole    String?   @map("buyer_role")
  fee          Decimal   @default(0)
  netAmount    Decimal   @map("net_amount") // totalAmount - fee
  tradedAt     DateTime  @default(now()) @map("traded_at")

  settlementStatus TradeSettlementStatus @default(Pending) @map("settlement_status")
  trusteeId        Int?                  @map("trustee_id")
  settledAt        DateTime?             @map("settled_at")

  asset     Asset               @relation(fields: [assetId], references: [id])
  listing   MarketplaceListing? @relation(fields: [listingId], references: [id])
  buyer     Account?            @relation("BuyerTrades", fields: [buyerId], references: [id])
  seller    Account             @relation("SellerTrades", fields: [sellerId], references: [id])
  account   Account?            @relation(fields: [accountId], references: [id])
  accountId Int?                @map("account_id")

  @@index([assetId, tradedAt])
  @@index([buyerId])
  @@index([sellerId])
  @@index([settlementStatus])
  @@map("marketplace_trade")
}

enum TradeSettlementStatus {
  Pending  @map("pending")
  Approved @map("approved")

  @@map("trade_settlement_status")
}

// A compatible Ask+Bid pair found by the match engine, held for Trustee
// review before it is allowed to proceed to trade execution/order creation.
// PendingTrusteeApproval -> Approved -> Matched (consumed by ExecuteTradeListener)
// PendingTrusteeApproval -> Rejected (terminal, never matched)
enum MatchApprovalStatus {
  PendingTrusteeApproval @map("pending_trustee_approval")
  Approved               @map("approved")
  Rejected               @map("rejected")
  Matched                @map("matched")

  @@map("match_approval_status")
}

model MarketplacePotentialMatch {
  id              Int                 @id @default(autoincrement())
  assetId         Int                 @map("asset_id")
  askListingId    Int                 @map("ask_listing_id")
  bidListingId    Int                 @map("bid_listing_id")
  matchedQuantity Int                 @map("matched_quantity")
  tradePrice      Decimal             @map("trade_price")
  status          MatchApprovalStatus @default(PendingTrusteeApproval)

  trusteeId  Int?      @map("trustee_id")
  approvedAt DateTime? @map("approved_at")

  rejectedBy      Int?      @map("rejected_by")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset      Asset              @relation(fields: [assetId], references: [id])
  askListing MarketplaceListing @relation("AskPotentialMatch", fields: [askListingId], references: [id])
  bidListing MarketplaceListing @relation("BidPotentialMatch", fields: [bidListingId], references: [id])

  @@index([assetId, status])
  @@index([askListingId, status])
  @@index([bidListingId, status])
  @@map("marketplace_potential_match")
}

model AssetMarketStat {
  id            Int     @id @default(autoincrement())
  assetId       Int     @unique @map("asset_id")
  currentPrice  Decimal @map("current_price")
  volume24h     Decimal @map("volume_24h")
  units24h      Int     @map("units_24h")
  openPrice24h  Decimal @map("open_price_24h")
  highPrice24h  Decimal @map("high_price_24h")
  lowPrice24h   Decimal @map("low_price_24h")
  closePrice24h Decimal @map("close_price_24h")

  priceChange24h Decimal   @map("price_change_24h")
  lastResetAt    DateTime? @map("last_reset_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id])

  @@map("asset_market_stat")
}

model Holding {
  id                Int      @id @default(autoincrement())
  accountId         Int      @map("account_id")
  assetId           Int      @map("asset_id")
  availableQuantity Decimal  @default(0) @map("available_quantity")
  lockedQuantity    Decimal  @default(0) @map("locked_quantity")
  averageBuyPrice   Decimal  @default(0) @map("average_buy_price")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])
  asset   Asset   @relation(fields: [assetId], references: [id])

  @@unique([accountId, assetId])
  @@index([accountId])
  @@index([assetId])
  @@map("holdings")
}

model InvoiceDetails {
  id                Int       @id @default(autoincrement())
  accountId         Int?      @map("account_id")
  assetId           Int?      @map("asset_id")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  email             String    @map("email")
  mobile            String    @map("mobile")
  tokenAmount       Int       @map("token_amount")
  orderId           String    @map("order_id")
  rozarpayPaymentId String    @map("rozarpay_payment_id")
  assetTitle        String    @map("asset_title")
  invoiceUrl        String    @map("invoice_url")
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  account Account? @relation(fields: [accountId], references: [id])
  asset   Asset?   @relation(fields: [assetId], references: [id])

  @@map("invoice_details")
}

model SecondaryClubs {
  id          Int       @id @default(autoincrement())
  title       String?
  description String?
  status      String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  assetId Int?   @unique @map("asset_id")
  asset   Asset? @relation(fields: [assetId], references: [id])

  votes                  Vote[]
  clubMembershipRequests ClubMembershipRequest[]
  spv                    Spv?

  @@map("secondar_clubs")
}

enum VoteChoice {
  Yes     @map("yes")
  No      @map("no")
  Abstain @map("abstain")

  @@map("vote_choice")
}

model Vote {
  id              Int        @id @default(autoincrement())
  secondaryClubId Int        @map("secondary_club_id")
  assetId         Int        @map("asset_id")
  accountId       Int        @map("account_id")
  choice          VoteChoice
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  secondaryClub SecondaryClubs @relation(fields: [secondaryClubId], references: [id])
  account       Account        @relation(fields: [accountId], references: [id])

  @@unique([secondaryClubId, accountId])
  @@map("vote")
}

enum MembershipStatus {
  NdaPending           @map("nda_pending")
  PendingAdminApproval @map("pending_admin_approval")
  Approved             @map("approved")
  Rejected             @map("rejected")

  @@map("membership_status")
}

model ClubMembershipRequest {
  id              Int              @id @default(autoincrement())
  ndaAccepted     Boolean          @default(false) @map("nda_accepted")
  status          MembershipStatus
  approvedBy      Int?             @map("approved_by")
  approvedAt      DateTime?        @map("approved_at")
  rejectionReason String?          @map("rejection_reason")
  createdAt       DateTime         @default(now()) @map("created_at")

  accountId       Int            @map("account_id")
  secondaryClubId Int            @map("secondary_club_id")
  account         Account        @relation(fields: [accountId], references: [id])
  secondaryClub   SecondaryClubs @relation(fields: [secondaryClubId], references: [id])

  @@unique([secondaryClubId, accountId])
  @@map("club_membership_request")
}

enum SpvStatus {
  Active   @map("active")
  Disabled @map("disabled")

  @@map("spv_status")
}

model Spv {
  id              Int       @id @default(autoincrement())
  name            String
  secondaryClubId Int       @unique @map("secondary_club_id")
  createdById     Int?      @map("created_by_id")
  status          SpvStatus @default(Active)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  secondaryClub SecondaryClubs @relation(fields: [secondaryClubId], references: [id])
  members       SpvMember[]

  @@map("spv")
}

model SpvMember {
  id        Int      @id @default(autoincrement())
  spvId     Int      @map("spv_id")
  accountId Int      @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")

  spv     Spv     @relation(fields: [spvId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@unique([spvId, accountId])
  @@map("spv_member")
}

enum RoleType {
  System @map("system")
  Custom @map("custom")

  @@map("role_type")
}

enum RoleStatus {
  Active   @map("active")
  InActive @map("inactive")

  @@map("role_status")
}

model Role {
  id               Int              @id @default(autoincrement())
  name             String           @unique
  description      String?
  type             RoleType         @default(Custom)
  status           RoleStatus       @default(Active)
  isProtected      Boolean          @default(false) @map("is_protected")
  createdByAdminId Int?             @map("created_by_admin_id")
  createdByAdmin   Admin?           @relation("RoleCreatedBy", fields: [createdByAdminId], references: [id])
  updatedByAdminId Int?             @map("updated_by_admin_id")
  updatedByAdmin   Admin?           @relation("RoleUpdatedBy", fields: [updatedByAdminId], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  permissions      RolePermission[]
  admins           Admin[]
  accounts         Account[]

  @@map("role")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       Int        @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int        @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  actorAdminId Int      @map("actor_admin_id")
  actorAdmin   Admin    @relation(fields: [actorAdminId], references: [id])
  action       String
  targetType   String   @map("target_type")
  targetId     Int      @map("target_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model FractionsConsent {
  id              Int     @id @default(autoincrement())
  buyerConsent    Boolean @default(false) @map("buyer_consent")
  rejectionReason String? @map("rejetion_reason")

  accountId Int @map("account_id")
  assetId   Int @map("asset_id")

  account Account @relation(fields: [accountId], references: [id])
  asset   Asset   @relation(fields: [assetId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountId, assetId])
  @@map("fractions_consent")
}
