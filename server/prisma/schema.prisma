datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum AdminStatus {
  Active @map("active")

  @@map("admin_status")
}

enum AdminType {
  SuperAdmin @map("super_admin")
  SubAdmin   @map("sub_admin")

  @@map("admin_type")
}

model Admin {
  id               Int         @id @default(autoincrement())
  firstname        String
  lastname         String
  email            String      @unique
  profileImage     String?     @map("profile_image")
  status           AdminStatus @default(Active)
  type             AdminType   @default(SubAdmin)
  roleId           Int?        @map("role_id")
  role             Role?       @relation(fields: [roleId], references: [id])
  createdByAdminId Int?        @map("created_by_admin_id")
  createdByAdmin   Admin?      @relation("AdminCreatedBy", fields: [createdByAdminId], references: [id])
  createdAdmins    Admin[]     @relation("AdminCreatedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meta         AdminMeta?
  accounts     Account[]
  rolesCreated Role[]     @relation("RoleCreatedBy")
  rolesUpdated Role[]     @relation("RoleUpdatedBy")
  auditLogs    AuditLog[]

  @@map("admin")
}

model AdminMeta {
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")
  admin        Admin   @relation(fields: [adminId], references: [id])
  adminId      Int     @unique() @map("admin_id")

  @@map("admin_meta")
}

enum AccountStatus {
  Active    @map("active")
  Blocked   @map("blocked")
  Suspended @map("suspended")

  @@map("account_status")
}

// CorporateInvestor complete KYC (individual) before buying fractions.
// Company(Business) -> company will perform KYB then KYC for director who bring company then fill RWA to list Asset.
// SPV(Entity ) -> Business user -> create account -> Complete KYC -> Fill RWA.
// Broker(Mediator of Asset and Investor) ->Business user -> create account -> Complete KYC -> Fill RWA.
// Trustee -> Business user -> create account -> Complete KYC -> Fill RWA.
// Asset Owner -> Business user -> create account -> Complete KYC -> Fill RWA.
// Developer(Builder) -> Business user -> create account -> Complete KYC -> Fill RWA.
enum AccountType {
  Company           @map("company") // create the property (KYC , KYB) 
  Developer         @map("developer")
  Business          @map("business")
  Spv               @map("spv")
  Broker            @map("broker")
  CorporateInvestor @map("corporate_investor")
  Trustee           @map("trustee")
  AssetOwner        @map("asset_owner") //create the property
  Director          @map("director")

  @@map("account_type")
}

model Account {
  id                 Int           @id @default(autoincrement())
  firstname          String
  lastname           String
  email              String        @unique
  dialCode           String?       @map("dial_code")
  mobile             String?       @unique
  profileImage       String?       @map("profile_image")
  isVerified         Boolean       @default(false) @map("is_verified")
  countryId          Int?          @map("country_id")
  createdById        Int?          @map("created_by_id")
  isDeleted          Boolean       @default(false) @map("is_deleted")
  type               AccountType
  status             AccountStatus @default(Active)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  isDocumentUploaded Boolean       @default(false) @map("is_docuemnt_uploaded")
  currentAddressId   Int?          @map("current_address_id")
  permanentAddressId Int?          @map("permanent_address_id")

  meta                          AccountMeta?
  kyc                           Kyc?
  referralCampaign              ReferralCampaign[]
  companyKyc                    CompanyKyc?
  userInviteContext             UserInviteContext?
  messages                      Message[]
  chatrooms                     ChatRoom[]
  blocker                       BlockedUser[]                   @relation("Blocker")
  blocked                       BlockedUser[]                   @relation("Blocked")
  chatroomUsers                 ChatRoomUser[]
  settings                      AccountSetting[]
  entityDocument                EntityDocument[]
  currentAddress                Address?                        @relation("AccountCurrentAddress", fields: [currentAddressId], references: [id])
  permanentAddress              Address?                        @relation("AccountPermanentAddress", fields: [permanentAddressId], references: [id])
  country                       Country?                        @relation(fields: [countryId], references: [id])
  createdBy                     Admin?                          @relation(fields: [createdById], references: [id])
  companies                     Company[]
  assets                        Asset[]
  purchases                     AssetPurchase[]
  wallets                       Wallet[]
  savedAssets                   SavedAsset[]
  notificationViews             NotificationViews[]
  paymentRequests               PaymentRequest[]
  referralUsage                 ReferralUsage[]
  assetOwnerInvite              AssetOwnerInvite[]
  commissionPayoutRequest       CommissionPayoutRequest[]
  brokerCommissions             ReferralCommission[]            @relation("BrokerCommission")
  investorCommissions           ReferralCommission[]            @relation("ReferredUserCommission")
  brokerCommissionContracts     AssetBrokerCommissionContract[] @relation("BrokerCommissionContracts")
  assetOwnerCommissionContracts AssetBrokerCommissionContract[] @relation("AssetOwnerCommissionContracts")
  category                      Category[]
  groupMember                   GroupMember[]
  sharedAssets                  SharedAsset[]                   @relation("SharedAssets")
  assetInterests                AssetInterest[]
  marketplaceListings           MarketplaceListing[]
  marketplaceTrades             MarketplaceTrade[]
  buyerTrades                   MarketplaceTrade[]              @relation("BuyerTrades")
  sellerTrades                  MarketplaceTrade[]              @relation("SellerTrades")
  holdings                      Holding[]
  invoiceDetails                InvoiceDetails[]
  votes                         Vote[]
  clubMembershipRequests        ClubMembershipRequest[]
  spvMemberships                SpvMember[]
  role                          Role?                           @relation(fields: [roleId], references: [id])
  roleId                        Int?                            @map("role_id")
  fractionsConsents             FractionsConsent[]

  @@map("account")
}

model AccountMeta {
  googleId       String?   @unique @map("google_id")
  passwordSalt   String?   @map("password_salt")
  passwordHash   String?   @map("password_hash")
  panNumber      String?   @map("pan_number")
  passportNumber String?   @map("passport_number")
  emiratiId      String?   @map("emirati_id")
  occupation     String?   @map("occupation")
  monthlyIncome  String?   @map("monthly_income")
  licenseNumber  String?   @map("license_number")
  licenseExpiry  DateTime? @map("license_expiry")
  dateOfBirth    DateTime? @map("date_of_birth")

  account   Account @relation(fields: [accountId], references: [id])
  accountId Int     @unique() @map("account_id")

  @@map("account_meta")
}

model Country {
  id       Int    @id @default(autoincrement())
  name     String
  dialCode String @map("dial_code")
  isoCode  String @map("iso_code")
  flag     String

  accounts Account[]

  @@map("country")
}

enum OtpTransport {
  Email  @map("email")
  Mobile @map("mobile")

  @@map("otp_transport")
}

model Otp {
  code             String
  attempt          Int          @default(1) @db.SmallInt
  lastSentAt       DateTime     @default(now()) @map("last_sent_at")
  retries          Int          @default(0) @db.SmallInt
  transport        OtpTransport
  target           String
  lastCodeVerified Boolean      @default(false) @map("last_code_verified")
  blocked          Boolean      @default(false)

  @@unique([transport, target])
  @@map("otp")
}

enum SettingType {
  Binary       @map("binary")
  MultiSelect  @map("multi_select")
  SingleSelect @map("single_select")

  @@map("setting_type")
}

enum SettingContext {
  Account @map("account")
  System  @map("System")

  @@map("setting_context")
}

model Setting {
  id               Int            @id @default(autoincrement())
  mappedTo         String         @map("mapped_to")
  text             String         @default("")
  description      String         @default("")
  type             SettingType
  context          SettingContext
  default          Json
  isDefinedOptions Boolean        @map("is_defined_options")
  subSettings      Setting[]      @relation("SubSettings")
  dependsOn        Setting?       @relation("SubSettings", fields: [parentId], references: [id])
  parentId         Int?           @map("parent_id")

  options         SettingOption[]
  accountSettings AccountSetting[]
  systemSettings  SystemSetting[]

  @@unique([context, mappedTo])
  @@map("setting")
}

model SettingOption {
  id    Int    @id @default(autoincrement())
  text  String @default("")
  value String

  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@unique([settingId, value])
  @@map("setting_option")
}

model AccountSetting {
  selection Json

  account   Account @relation(fields: [accountId], references: [id])
  accountId Int     @map("account_id")
  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([accountId, settingId])
  @@map("account_setting")
}

model SystemSetting {
  selection Json

  setting   Setting @relation(fields: [settingId], references: [id])
  settingId Int     @map("setting_id")

  @@id([settingId])
  @@map("system_setting")
}

enum KycStatus {
  Draft     @map("draft")
  Submitted @map("submitted")
  Pending   @map("pending")
  Approved  @map("approved")
  Rejected  @map("rejected")

  @@map("kyc_status")
}

enum KycVerifier {
  Trustee @map("trustee")
  Admin   @map("admin")

  @@map("kyc_verifier")
}

model Kyc {
  id              Int         @id @default(autoincrement())
  accountId       Int         @unique @map("account_id")
  status          KycStatus   @default(Draft)
  verifier        KycVerifier
  submittedAt     DateTime?   @map("submitted_at")
  reviewedAt      DateTime?   @map("reviewed_at")
  reviewedById    Int?        @map("reviewed_by_id")
  rejectionReason String?     @map("rejection_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  account         Account     @relation(fields: [accountId], references: [id])

  @@map("kyc")
}

model Document {
  id                   Int                       @id @default(autoincrement())
  developerName        String                    @unique @map("developer_name")
  name                 String
  documents            EntityDocument[]
  documentRequirements AccountRequiredDocument[]

  @@map("document")
}

model AccountRequiredDocument {
  id             Int         @id @default(autoincrement())
  accountType    AccountType @map("account_type")
  documentTypeId Int         @map("document_type_id")
  documentType   Document    @relation(fields: [documentTypeId], references: [id])
  mandatory      Boolean     @default(true)
  order          Int         @default(1)
  instructions   String?     @map("instructions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountType, documentTypeId])
  @@map("document_requirement")
}

model EntityDocument {
  id                 Int      @id @default(autoincrement())
  documentTypeId     Int      @map("document_type_id")
  documentType       Document @relation(fields: [documentTypeId], references: [id])
  companyId          Int?     @map("company_id")
  directorId         Int?     @map("director_id")
  accountId          Int?     @map("account_id")
  url                String?
  documentIdentifier String?  @map("document_identifier")
  isVerified         Boolean  @default(false) @map("is_verified")
  remark             String?

  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  verifiedAt DateTime? @map("verified_at")

  company  Company?  @relation("CompanyDocuments", fields: [companyId], references: [id])
  director Director? @relation("DirectorDocuments", fields: [directorId], references: [id])
  account  Account?  @relation(fields: [accountId], references: [id])

  @@unique([documentTypeId, accountId, companyId, directorId])
  @@map("entity_document")
}

model Address {
  id           Int     @id @default(autoincrement())
  addressLine1 String  @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String
  state        String
  pincode      String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accountsCurrentAddress      Account[]  @relation("AccountCurrentAddress")
  accountsPermanentAddress    Account[]  @relation("AccountPermanentAddress")
  companiesRegisteredAddress  Company[]  @relation("CompanyRegisteredAddress")
  companiesOperationalAddress Company[]  @relation("CompanyOperationalAddress")
  directorsCurrentAddress     Director[] @relation("DirectorCurrentAddress")
  directorsPermanentAddress   Director[] @relation("DirectorPermanentAddress")

  @@map("address")
}

enum EntityType {
  PvtLtd      @map("pvt_ltd")
  Llp         @map("llp")
  Llc         @map("llc")
  FzLlc       @map("fz_llc")
  Spv         @map("spv")
  Partnership @map("partnership")
  Trust       @map("trust")

  @@map("entity_type")
}

model Company {
  id                   Int        @id @default(autoincrement())
  legalEntityName      String     @map("legal_entity_name")
  tradeName            String?    @map("trade_name")
  entityType           EntityType @map("entity_type")
  cinOrTradeLicenseNo  String     @map("cin_or_trade_license_no")
  dateOfIncorporation  DateTime   @map("date_of_incorporation")
  companyEmail         String     @map("company_email")
  companyPhone         String     @map("company_phone")
  websiteUrl           String?    @map("website_url")
  accountId            Int        @map("account_id")
  registeredAddressId  Int?       @map("registered_address_id")
  operationalAddressId Int?       @map("operational_address_id")
  isVerified           Boolean    @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registeredAddress  Address?         @relation("CompanyRegisteredAddress", fields: [registeredAddressId], references: [id])
  operationalAddress Address?         @relation("CompanyOperationalAddress", fields: [operationalAddressId], references: [id])
  account            Account          @relation(fields: [accountId], references: [id])
  meta               CompanyMeta?
  directors          Director[]
  documents          EntityDocument[] @relation("CompanyDocuments")

  @@map("company")
}

enum SourceOfFunds {
  InternalAccruals @map("internal_accruals")
  Investors        @map("investors")
  Vc               @map("vc")
  Borrowings       @map("borrowings")
  Others           @map("others")

  @@map("source_of_funds")
}

model CompanyMeta {
  id                               Int            @id @default(autoincrement())
  companyId                        Int            @unique @map("company_id")
  industryType                     String?        @map("industry_type")
  natureOfBusiness                 String?        @map("nature_of_business")
  businessDescription              String?        @map("business_description")
  expectedMonthlyTransactionVolume Float?         @map("expected_monthly_transaction_volume")
  expectedSourceOfFunds            SourceOfFunds? @map("expected_source_of_funds")
  countriesOfOperation             String[]       @default([]) @map("countries_of_operation")
  isCompanyPubliclyListed          Boolean        @default(false) @map("is_company_publicly_listed")
  panNumber                        String?        @map("pan_number")
  gstNumber                        String?        @map("gst_number")
  tanNumber                        String?        @map("tan_number")
  tradeLicenseExpiryDate           DateTime?      @map("trade_license_expiry_date")
  placeOfBusinessProofType         String?        @map("place_of_business_proof_type")

  panVerified Boolean @default(false) @map("pan_verified")
  gstVerified Boolean @default(false) @map("gst_verified")

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_meta")
}

enum RoleInCompany {
  Director            @map("director")
  Promoter            @map("promoter")
  Ubo                 @map("ubo")
  Trustee             @map("trustee")
  AuthorisedSignatory @map("authorised_signatory")

  @@map("role_in_company")
}

model Director {
  id                 Int           @id @default(autoincrement())
  company            Company       @relation(fields: [companyId], references: [id])
  companyId          Int           @map("company_id")
  firstName          String        @map("first_name")
  lastName           String        @map("last_name")
  roleInCompany      RoleInCompany @map("role_in_company")
  dateOfBirth        DateTime      @map("date_of_birth")
  nationality        String
  currentAddressId   Int?          @map("current_address_id")
  permanentAddressId Int?          @map("permanent_address_id")
  email              String
  mobileNumber       String        @map("mobile_number")
  isVerified         Boolean       @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents        EntityDocument[] @relation("DirectorDocuments")
  permanentAddress Address?         @relation("DirectorPermanentAddress", fields: [permanentAddressId], references: [id])
  currentAddress   Address?         @relation("DirectorCurrentAddress", fields: [currentAddressId], references: [id])
  directorMeta     DirectorMeta?

  @@map("director")
}

model DirectorMeta {
  id               Int      @id @default(autoincrement())
  panNumber        String?  @map("pan_number")
  emiratesIdNumber String?  @map("emirates_id_number")
  passportNumber   String?  @map("passport_number")
  director         Director @relation(fields: [directorId], references: [id])
  directorId       Int      @unique() @map("director_id")

  @@map("director_meta")
}

model CompanyKyc {
  id             Int       @id @default(autoincrement())
  accountId      Int       @unique @map("account_id")
  account        Account   @relation(fields: [accountId], references: [id])
  // KYB Company
  kybStatus      KycStatus @default(Draft) @map("kyb_status")
  kybSubmittedAt DateTime? @map("kyb_submitted_at")
  kybReviewedAt  DateTime? @map("kyb_reviewed_at")
  kybReviewedBy  Int?      @map("kyb_reviewed_by")

  // KYC Director
  kycStatus      KycStatus @default(Draft) @map("kyc_status")
  kycSubmittedAt DateTime? @map("kyc_submitted_at")
  kycReviewedAt  DateTime? @map("kyc_reviewed_at")
  kycReviewedBy  Int?      @map("kyc_reviewed_by")

  // Overall
  overallStatus KycStatus @default(Draft) @map("overall_status")
  remarks       String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("company_kyc")
}

enum RWAStatus {
  Draft                @map("draft")
  LegalReviewed        @map("legal_reviewed")
  ValuationReviewed    @map("valuation_reviewed")
  DueDiligence         @map("due_diligence")
  Submitted            @map("submitted")
  UnderReview          @map("under_review")
  Approved             @map("approved")
  Rejected             @map("rejected")
  LegalRejected        @map("legal_rejected")
  ValuationRejected    @map("valuation_rejected")
  DueDiligenceRejected @map("due_diligence_rejected")

  @@map("rwa_status")
}

enum AdminFractionalizationStatus {
  Pending   @map("pending")
  Completed @map("completed")

  @@map("admin_fractionalization_status")
}

model RWARequest {
  id      Int   @id @default(autoincrement())
  // Asset
  assetId Int   @unique @map("asset_id")
  asset   Asset @relation(fields: [assetId], references: [id])

  // trastee flow
  status                      RWAStatus  @default(Draft) @map("status")
  statusForLegal              RWAStatus? @map("status_for_legal")
  statusForValuation          RWAStatus? @map("status_for_valuation")
  statusForDueDiligence       RWAStatus? @map("status_for_dueDiligence")
  trusteeId                   Int?       @map("trustee_id")
  trusteeComment              String?    @map("trustee_comment")
  rejectionReason             String?    @map("rejection_reason")
  legalRejectionReason        String?    @map("legal_rejection_reason")
  valuationRejectionReason    String?    @map("valuation_rejection_reason")
  dueDiligenceRejectionReason String?    @map("due_diligence_rejection_reason")
  approvedAt                  DateTime?  @map("approved_at")
  rejectedAt                  DateTime?  @map("rejected_at")

  //admin fractionalization
  fractionalizationStatus AdminFractionalizationStatus @default(Pending) @map("fractionalization_status")
  fractionalizedById      Int?                         @map("fractionalized_by_id")
  fractionalizedAt        DateTime?                    @map("fractionalized_at")

  // final listing approval by admin (post trustee approval)
  listingAmount Decimal? @map("listing_amount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rwa_request")
}

enum AssetType {
  RealEstate @map("real_estate")
  Solar      @map("solar")
  Machinery  @map("machinery")
  EVFleet    @map("ev_fleet")
  Warehouse  @map("warehouse")
  Store      @map("store")
  Gold       @map("gold")
  Business   @map("business")
  IP         @map("ip")
  Others     @map("others")

  @@map("asset_type")
}

enum OwnershipModel {
  DeveloperOwned @map("developer_owned")
  SPVOwned       @map("spv_owned")
  PlatformOwned  @map("platform_owned")
  SingleOwner    @map("single_owner")
  Leasehold      @map("leasehold")
  Freehold       @map("freehold")
  Privatelimited @map("private_limited")
  Partnership    @map("partnership")
  Limited        @map("limited")
  Individual     @map("individual")
  Trust          @map("trust")
  LLP            @map("llp")
  Others         @map("others")

  @@map("ownership_model")
}

enum AssetStatus {
  Draft       @map("draft")
  Reviewed    @map("reviewed")
  Rejected    @map("rejected")
  Available   @map("Available")
  Funded      @map("Funded")
  Exited      @map("Exited")
  RequestLive @map("request_live")

  @@map("asset_status")
}

model AssetOwner {
  id      Int     @id @default(autoincrement())
  assetId Int     @unique @map("asset_id")
  name    String?
  email   String?
  mobile  String?

  asset Asset @relation(fields: [assetId], references: [id])

  @@map("asset_owner")
}

model Asset {
  id                  Int                     @id @default(autoincrement())
  accountId           Int?                    @map("account_id")
  assetType           AssetType               @map("asset_type")
  assetSubType        String?                 @map("asset_sub_type")
  assetTitle          String                  @map("asset_title")
  currentOwnerName    String                  @map("current_owner_name")
  mapUrl              String?                 @map("map_url")
  assetAppreciation   Decimal                 @default(0) @map("asset_appreciation")
  totalFractions      Int                     @default(0) @map("total_fraction")
  soldFractions       Int                     @default(0) @map("sold_fraction")
  remainingFractions  Int                     @default(0) @map("remaining_fraction")
  yieldPercentage     Int                     @default(0) @map("yield_percentage")
  isSoldOut           Boolean                 @default(false) @map("is_sold_out")
  isMarketplace       Boolean                 @default(false) @map("is_marketplace")
  status              AssetStatus             @default(Draft) @map("status")
  isVisible           Boolean                 @default(false) @map("is_visible")
  updateAsset         Boolean                 @default(false) @map("update_asset")
  isBrokerReferred    Boolean?                @map("is_broker_referred")
  ownerStatus         ReferralApprovalStatus? @map("owner_status")
  isVerified          Boolean                 @default(false) @map("is_verified")
  ownershipModel      OwnershipModel          @map("ownership_model")
  ownershipModelOther String?                 @map("ownership_model_other")
  tempGroupIds        Int[]                   @default([]) @map("temp_group_ids")
  lastNotifiedAt      DateTime?               @map("last_notified_at")
  rejectionReason     String?                 @map("rejection_reason")
  approvedAt          DateTime?               @map("approved_at")
  rejectedAt          DateTime?               @map("rejected_at")
  steps               String?                 @map("steps")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  meta                          AssetMeta[]
  price                         AssetPrice?
  rwaRequest                    RWARequest?
  assetOwnerInvite              AssetOwnerInvite?
  documents                     AssetDocument[]
  propertyInterest              PropertyInterest[]
  account                       Account?                        @relation(fields: [accountId], references: [id])
  assetPurchases                AssetPurchase[]
  savedAssets                   SavedAsset[]
  referralCommission            ReferralCommission[]
  assetBrokerCommissionContract AssetBrokerCommissionContract[]
  sharedAsset                   SharedAsset?
  assetOwner                    AssetOwner?
  chatRooms                     ChatRoom[]
  marketplaceListings           MarketplaceListing[]
  marketplaceTrades             MarketplaceTrade[]
  marketplacePotentialMatches   MarketplacePotentialMatch[]
  assetMarketStat               AssetMarketStat?
  holdings                      Holding[]
  invoiceDetails                InvoiceDetails[]
  secondaryClub                 SecondaryClubs?
  fractionsConsents             FractionsConsent[]

  @@map("asset")
}

model AssetPrice {
  id      Int @id @default(autoincrement())
  assetId Int @unique @map("asset_id")

  initialPricePerFraction Decimal @default(0) @map("initial_price")
  currentPricePerFraction Decimal @default(0) @map("current_price")

  asset Asset @relation(fields: [assetId], references: [id])

  @@map("asset_price")
}

enum MetaType {
  String  @map("string")
  Number  @map("number")
  Boolean @map("boolean")
  Date    @map("date")

  @@map("meta_type")
}

model AssetMeta {
  id         Int       @id @default(autoincrement())
  asset      Asset     @relation(fields: [assetId], references: [id])
  assetId    Int       @map("asset_id")
